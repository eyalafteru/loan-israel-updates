<!-- 🔥 Performance Self-Check & WordPress Safety Check -->
<script>
  (function() {
      'use strict';
      
      const namespace = 'WPC_KerenLoan_H3K9_PerformanceCheck';
      if (window[namespace]) return;
      
      // מגבלות ביצועים לפי wordpress-ruls.txt
      const PERFORMANCE_LIMITS = {
          MAX_JS_SIZE: 30 * 1024, // 30KB
          MAX_CSS_SIZE: 20 * 1024, // 20KB
          MAX_EVENT_LISTENERS: 10,
          MAX_ANIMATION_DURATION: 300, // ms
          MIN_TOUCH_TARGET: 44 // px
      };
      
      // Performance API monitoring
      function measurePerformance(name, fn) {
          if (!performance.mark) return fn();
          
          performance.mark(`${name}-start`);
          const result = fn();
          performance.mark(`${name}-end`);
          performance.measure(name, `${name}-start`, `${name}-end`);
          
          // לוג רק בdevelopment
          if (window.location.hostname === 'localhost' || window.location.hostname.includes('dev')) {
              const measure = performance.getEntriesByName(name)[0];
              if (measure) {
                  console.log(`${name}: ${measure.duration.toFixed(2)}ms`);
              }
          }
          
          return result;
      }
      
      // Memory Usage Monitoring (Chrome only)
      function checkMemory() {
          if (performance.memory) {
              const used = performance.memory.usedJSHeapSize;
              const limit = performance.memory.jsHeapSizeLimit;
              const percentage = (used / limit * 100).toFixed(1);
              
              if (percentage > 70) {
                  console.warn(`זיכרון גבוה: ${percentage}%`);
              }
          }
      }
      
      // בדיקה עצמית של הקוד
      function performanceSelfCheck() {
          const issues = [];
          
          // בדיקת גודל JavaScript
          const scripts = document.querySelectorAll('script');
          let totalJSSize = 0;
          scripts.forEach(script => {
              if (script.textContent) {
                  totalJSSize += script.textContent.length;
              }
          });
          
          if (totalJSSize > PERFORMANCE_LIMITS.MAX_JS_SIZE) {
              issues.push(`JavaScript גדול מדי: ${(totalJSSize/1024).toFixed(1)}KB`);
          }
          
          // בדיקת כפתורים במובייל
          const buttons = document.querySelectorAll('button');
          buttons.forEach(btn => {
              const rect = btn.getBoundingClientRect();
              if (rect.height < PERFORMANCE_LIMITS.MIN_TOUCH_TARGET) {
                  issues.push(`כפתור קטן מדי למובייל: ${btn.textContent?.slice(0, 20)}`);
              }
          });
          
          // בדיקת animations
          if (typeof document.getAnimations === 'function') {
              const animations = document.getAnimations();
              animations.forEach(anim => {
                  const timing = anim.effect?.getTiming();
                  if (timing && timing.duration > PERFORMANCE_LIMITS.MAX_ANIMATION_DURATION) {
                      issues.push('אנימציה ארוכה מדי');
                  }
              });
          }
          
          return issues;
      }
      
      // WordPress Safety Check
      function wordpressSafetyCheck() {
          const warnings = [];
          
          // בדיקה שלא נגענו ב-WordPress globals
          if (window.jQuery !== window.$) {
              warnings.push('jQuery global may have been modified');
          }
          
          // בדיקה של document title (לא צריך לשנות)
          const originalTitle = document.title;
          setTimeout(() => {
              if (document.title !== originalTitle) {
                  warnings.push('Document title was modified');
              }
          }, 1000);
          
          return warnings;
      }
      
      // הרצה ראשונית
      setTimeout(() => {
          measurePerformance('performance-check', () => {
              const issues = performanceSelfCheck();
              const warnings = wordpressSafetyCheck();
              
              if (issues.length || warnings.length) {
                  console.group('🔍 Performance & WordPress Check');
                  if (issues.length) {
                      console.warn('Performance Issues:', issues);
                  }
                  if (warnings.length) {
                      console.warn('WordPress Safety Warnings:', warnings);
                  }
                  console.groupEnd();
              } else {
                  console.log('✅ Performance & WordPress checks passed');
              }
          });
          
          checkMemory();
      }, 2000);
      
      // בדיקת זיכרון כל דקה
      setInterval(checkMemory, 60000);
      
      window[namespace] = {
          version: '1.0.0',
          performanceSelfCheck,
          wordpressSafetyCheck
      };
  })();
  </script>
