<script>
  (function() {
      'use strict';
      
      // 🔒 JavaScript בטוח עם namespace ייחודי
      const namespace = 'WPC_KerenLoan_H3K9';
      if (window[namespace]) return;
      
      // Container validation
      const container = document.querySelector('.wpc-keren-loan-h3k9-wrapper') || document.body;
      
      // Event delegation מרכזי לגלילה
      const handleClick = function(e) {
          const action = e.target.closest('[data-action]');
          if (!action) return;
          
          const actionType = action.dataset.action;
          
          if (actionType === 'scroll-to-awg') {
              e.preventDefault();
              const awgTarget = document.querySelector('.wpc-keren-loan-h3k9-awg-container, .wpc-keren-loan-h3k9-awg-section, #wpc-awg-section');
              if (awgTarget) {
                  awgTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
          } else if (actionType === 'scroll-to-calculator') {
              e.preventDefault();
              const calcTarget = document.querySelector('#wpc-keren-loan-h3k9-calculator, .wpc-keren-loan-h3k9-calc-container, .wpc-calc-tabs-demo-container');
              if (calcTarget) {
                  calcTarget.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
          }
      };
      
      // Event listener יחיד עם delegation
      container.addEventListener('click', handleClick, { passive: false });
      
      // חשיפה מוגבלת
      window[namespace] = {
          version: '1.0.0',
          destroy() {
              container.removeEventListener('click', handleClick);
              delete window[namespace];
          }
      };
  })();
