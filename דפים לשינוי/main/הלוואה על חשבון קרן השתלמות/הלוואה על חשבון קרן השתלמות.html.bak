<script>
  // 🧮 Calculator JavaScript - בטוח עם namespace ייחודי ו-AbortController
  (function() {
      'use strict';
      
      const namespace = 'WPC_KerenLoan_H3K9_Calculator';
      if (window[namespace]) {
          console.warn(namespace + ' כבר קיים');
          return;
      }
      
      const container = document.querySelector('.wpc-keren-loan-h3k9-calc-container');
      if (!container) {
          console.error('Calculator container לא נמצא');
          return;
      }
      
      // AbortController לניקוי Event Listeners אוטומטי
      const controller = new AbortController();
      const signal = controller.signal;
      
      // נוסחאות חישוב PMT מדויקות
      function calculateKerenLoan(principal, months, kerenType) {
          const rates = {
              'liquid': 5.4,
              'notLiquid': 6.5,
              'teachers': 5.4,
              'government': 5.5
          };
          const rate = rates[kerenType] / 100 / 12;
          if (rate === 0) return principal / months;
          return principal * (rate * Math.pow(1 + rate, months)) / (Math.pow(1 + rate, months) - 1);
      }
      
      function calculateBankLoan(principal, months) {
          const rate = 11 / 100 / 12; // ריבית בנק ממוצעת
          return principal * (rate * Math.pow(1 + rate, months)) / (Math.pow(1 + rate, months) - 1);
      }
      
      function formatCurrency(amount) {
          return new Intl.NumberFormat('he-IL').format(Math.round(amount)) + ' ₪';
      }
      
      function updateCalculation() {
          const amount = parseInt(document.getElementById('amount-slider').value);
          const months = parseInt(document.getElementById('months-slider').value);
          const kerenType = document.getElementById('keren-type').value;
          
          const kerenPayment = calculateKerenLoan(amount, months, kerenType);
          const bankPayment = calculateBankLoan(amount, months);
          const monthlySavings = bankPayment - kerenPayment;
          const totalSavings = monthlySavings * months;
          
          document.getElementById('keren-payment').textContent = formatCurrency(kerenPayment);
          document.getElementById('bank-payment').textContent = formatCurrency(bankPayment);
          document.getElementById('monthly-savings').textContent = formatCurrency(monthlySavings);
          document.getElementById('total-savings').textContent = formatCurrency(totalSavings);
          

      }
      
      // Event delegation בטוח עם AbortController
      container.addEventListener('click', function(e) {
          const tab = e.target.closest('[data-tab]');
          if (tab) {
              // הסר active מכל הטאבים
              container.querySelectorAll('.wpc-calc-tab-demo, .wpc-keren-loan-h3k9-calc-tab').forEach(t => t.classList.remove('active'));
              container.querySelectorAll('.wpc-calc-panel, .wpc-keren-loan-h3k9-calc-panel').forEach(p => p.classList.remove('active'));
              
              // הוסף active לטאב ופאנל הנוכחיים
              tab.classList.add('active');
              const panel = container.querySelector(`[data-panel="${tab.dataset.tab}"]`);
              if (panel) panel.classList.add('active');
          }
      }, { signal });
      
      // עדכון ערכי סליידרים עם AbortController
      container.addEventListener('input', function(e) {
          if (e.target.id === 'amount-slider') {
              document.getElementById('amount-value').textContent = formatCurrency(e.target.value);
              updateCalculation();
          } else if (e.target.id === 'months-slider') {
              document.getElementById('months-value').textContent = e.target.value + ' חודשים';
              updateCalculation();
          }
      }, { signal });
      
      // עדכון בחירת קרן עם AbortController
      container.addEventListener('change', function(e) {
          if (e.target.id === 'keren-type') {
              updateCalculation();
          }
      }, { signal });
      
      // חישוב ראשוני
      updateCalculation();
      
      // Cleanup function
      function cleanup() {
          controller.abort(); // מסיר את כל הlisteners
          delete window[namespace];
      }
      
      // Page visibility cleanup (כשמשתמש עוזב העמוד)
      document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
              cleanup();
          }
      });
      
      // חשיפה מוגבלת לwindow
      window[namespace] = {
          version: '1.0.0',
          updateCalculation: updateCalculation,
          destroy: cleanup
      };
  })();
  </script>
<!-- 📝 אזור 4: פסקת פתיחה - הסבר מהיר - ✅ עוצב והושלם --><!-- תוכן: פסקה ראשונה מהתוכן הגולמי - עיצוב: wpc-section-demo-title -->
<section class="wpc-section-demo-header wpc-keren-loan-h3k9-section-header edit-hoverable" style="padding: 60px 20px;">
