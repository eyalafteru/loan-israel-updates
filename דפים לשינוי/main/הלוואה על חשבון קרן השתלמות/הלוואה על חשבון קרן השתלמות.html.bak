<!-- JavaScript לתפעול האקורדיון -->
<script>
  (function() {
      'use strict';
      
      // בדיקת namespace
      const NS = 'WPC_KerenLoan_H3K9';
      if (window[NS] && window[NS].accordionInitialized) return;
      
      // פונקציית toggle לאקורדיון - חשופה לשימוש ב-onclick
      window.toggleAccordion = function(header) {
          const content = header.nextElementSibling;
          const icon = header.querySelector('span');
          const isActive = header.classList.contains('active');
          
          // סגירת כל האקורדיונים האחרים
          document.querySelectorAll('.wpc-accordion-demo-header').forEach(h => {
              if (h !== header) {
                  h.classList.remove('active');
                  h.style.background = '#f8f9fa';
                  h.style.color = '';
                  h.style.borderColor = 'transparent';
                  const otherContent = h.nextElementSibling;
                  const otherIcon = h.querySelector('span');
                  if (otherContent) {
                  otherContent.classList.remove('active');
                  otherContent.style.maxHeight = '0';
                  }
                  if (otherIcon) {
                      otherIcon.style.transform = 'translateY(-50%)';
                      otherIcon.style.background = 'rgba(0,0,0,0.1)';
                  }
              }
          });
          
          if (isActive) {
              // סגירה
              header.classList.remove('active');
              header.style.background = '#f8f9fa';
              header.style.color = '';
              header.style.borderColor = 'transparent';
              if (content) {
              content.classList.remove('active');
              content.style.maxHeight = '0';
              }
              if (icon) {
                  icon.style.transform = 'translateY(-50%)';
                  icon.style.background = 'rgba(0,0,0,0.1)';
              }
          } else {
              // פתיחה
              header.classList.add('active');
              header.style.background = 'var(--primary)';
              header.style.color = 'white';
              header.style.borderColor = 'var(--primary)';
              if (content) {
              content.classList.add('active');
                  content.style.maxHeight = content.scrollHeight + 'px'; // חישוב גובה דינמי
              }
              if (icon) {
                  icon.style.transform = 'translateY(-50%) rotate(90deg)';
                  icon.style.background = 'rgba(255,255,255,0.2)';
              }
          }
      };

      // הוספת Event Listeners לאקורדיון באופן ידני (בנוסף ל-onclick ב-HTML אם קיים)
      document.querySelectorAll('.wpc-accordion-demo-header').forEach(header => {
          header.addEventListener('click', function() {
              window.toggleAccordion(this);
          });
      });
      
      // סימון שהאקורדיון אותחל
      if (!window[NS]) window[NS] = {};
      window[NS].accordionInitialized = true;
      
  })();
  </script>
