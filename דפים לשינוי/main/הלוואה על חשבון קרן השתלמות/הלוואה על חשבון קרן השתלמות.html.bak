<!-- 📊 אזור 16: השוואת קרנות - טבלת ריביות אינטראקטיבית - ✅ עוצב והושלם --><!-- תוכן מ-workpage.html שורות 170-203, עיצוב טבלה מותאם עם sorting + mobile cards -->

<script>
  // 📊 JavaScript לטבלת השוואה אינטראקטיבית - אזור 16
  function sortTable(columnIndex) {
    const table = document.querySelector('.wpc-keren-loan-h3k9-comparison-table');
    if (!table) return;
    
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    
    // Sort rows
    rows.sort((a, b) => {
      const aText = a.children[columnIndex].textContent.trim();
      const bText = b.children[columnIndex].textContent.trim();
      
      // For rate columns, extract numbers
      if (columnIndex === 2) {
        const aNum = parseFloat(aText.replace(/[^0-9.]/g, ''));
        const bNum = parseFloat(bText.replace(/[^0-9.]/g, ''));
        return aNum - bNum;
      }
      
      return aText.localeCompare(bText, 'he');
    });
    
    // Re-append sorted rows
    rows.forEach(row => tbody.appendChild(row));
    
    // Add visual feedback
    const headers = table.querySelectorAll('th');
    headers.forEach((header, index) => {
      if (index === columnIndex) {
        header.style.background = 'var(--warning)';
        setTimeout(() => {
          header.style.background = '';
        }, 1000);
      }
    });
  }
  </script>
