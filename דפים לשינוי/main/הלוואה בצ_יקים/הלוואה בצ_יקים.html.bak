<style>
    @import url('https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700;800&display=swap');
    
    #chk24-wrapper {
        /* צבעים ומשתנים */
        --lp-primary: #1e5490;
        --lp-primary-dark: #2a5fa0;
        --lp-secondary: #ff3b3b;
        --lp-success: #25D366;
        --lp-warning: #FF9800;
        --lp-text-dark: #333333;
        --lp-text-light: #666666;
        --lp-text-muted: #777777;
        --lp-background: #ffffff;
        --lp-gray-light: #f8f8f8;
        --lp-gray-medium: #e0e0e0;
        
        /* צללים */
        --lp-shadow-soft: 0 3px 10px rgba(0,0,0,0.06);
        --lp-shadow-medium: 0 10px 30px rgba(0,0,0,0.12);
        --lp-shadow-hover: 0 10px 40px rgba(0,0,0,0.15);
        
        /* אנימציות */
        --lp-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        
        /* הגדרות בסיס */
        font-family: 'Assistant', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--lp-text-dark);
        line-height: 1.6;
        direction: rtl;
        text-align: right;
    }
    
    /* Hero Section - מהיר ודינמי */
    #chk24-wrapper .chk24-hero {
        position: relative;
        min-height: 600px;
        background: linear-gradient(135deg, var(--lp-primary-dark) 0%, var(--lp-primary) 50%, #3498db 100%);
        overflow: hidden;
        display: flex;
        align-items: center;
        padding: 60px 20px;
    }
    
    #chk24-wrapper .chk24-hero__particles {
        position: absolute;
        inset: 0;
        opacity: 0.3;
    }
    
    #chk24-wrapper .chk24-hero__particle {
        position: absolute;
        width: 4px;
        height: 4px;
        background: white;
        border-radius: 50%;
        animation: chk24-float 20s infinite linear;
    }
    
    @keyframes chk24-float {
        0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
    }
    
    #chk24-wrapper .chk24-hero__content {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
    }
    
    #chk24-wrapper .chk24-hero__title {
        font-size: 3.5em;
        font-weight: 800;
        color: white;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        animation: chk24-fadeInDown 0.8s ease-out;
    }
    
    @keyframes chk24-fadeInDown {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    #chk24-wrapper .chk24-hero__subtitle {
        font-size: 1.5em;
        color: rgba(255,255,255,0.9);
        margin-bottom: 40px;
        animation: chk24-fadeInUp 0.8s ease-out 0.2s both;
    }
    
    @keyframes chk24-fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    #chk24-wrapper .chk24-hero__features {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-bottom: 40px;
        flex-wrap: wrap;
    }
    
    #chk24-wrapper .chk24-hero__feature {
        display: flex;
        align-items: center;
        gap: 10px;
        color: white;
        font-size: 1.1em;
        animation: chk24-fadeIn 0.8s ease-out 0.4s both;
    }
    
    @keyframes chk24-fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    #chk24-wrapper .chk24-hero__icon {
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    #chk24-wrapper .chk24-hero__cta {
        animation: chk24-pulse 2s ease-in-out infinite;
    }
    
    @keyframes chk24-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }
    
    #chk24-wrapper .chk24-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 18px 40px;
        font-size: 1.2em;
        font-weight: 700;
        text-decoration: none;
        border-radius: 50px;
        transition: var(--lp-transition);
        position: relative;
        overflow: hidden;
    }
    
    #chk24-wrapper .chk24-btn--primary {
        background: var(--lp-warning);
        color: white;
        box-shadow: 0 10px 30px rgba(255,152,0,0.3);
    }
    
    #chk24-wrapper .chk24-btn--primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(255,152,0,0.4);
    }
    
    #chk24-wrapper .chk24-btn__ripple {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
        transform: scale(0);
        transition: transform 0.6s ease-out;
    }
    
    #chk24-wrapper .chk24-btn:hover .chk24-btn__ripple {
        transform: scale(2);
    }
    
    /* פסקת פתיחה מעוצבת */
    #chk24-wrapper .chk24-intro {
        padding: 80px 20px;
        background: var(--lp-background);
    }
    
    #chk24-wrapper .chk24-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    
    #chk24-wrapper .chk24-section__title {
        font-size: 2.5em;
        font-weight: 700;
        color: var(--lp-primary);
        margin-bottom: 30px;
        position: relative;
        padding-right: 20px;
    }
    
    #chk24-wrapper .chk24-section__title::before {
        content: '';
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 40px;
        background: var(--lp-secondary);
        border-radius: 3px;
    }
    
    #chk24-wrapper .chk24-lead {
        font-size: 1.3em;
        line-height: 1.8;
        color: var(--lp-text-dark);
        margin-bottom: 40px;
    }
    
    #chk24-wrapper .chk24-widget-container {
        background: transparent !important;
        padding: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        position: relative;
        overflow: visible !important;
        max-width: 100% !important;
        width: 100% !important;
        margin: 0 auto !important;
        text-align: center !important;
    }
    
    #chk24-wrapper .chk24-widget-container::before {
        display: none !important;
    }
    
    /* מהי הלוואה בצ'קים - עם וידאו */
    #chk24-wrapper .chk24-what-is {
        padding: 60px 20px;
        background: var(--lp-gray-light);
    }
    
    #chk24-wrapper .chk24-video-wrapper {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        margin: 40px 0;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }
    
    #chk24-wrapper .chk24-video-wrapper iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }
    
    /* כרטיסי קהל יעד */
    #chk24-wrapper .chk24-audience {
        padding: 80px 20px;
        background: white;
    }
    
    #chk24-wrapper .chk24-audience__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 50px;
    }
    
    #chk24-wrapper .chk24-audience__card {
        background: white;
        border: 2px solid var(--lp-gray-medium);
        border-radius: 20px;
        padding: 30px;
        text-align: center;
        transition: var(--lp-transition);
        position: relative;
        overflow: hidden;
    }
    
    #chk24-wrapper .chk24-audience__card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--lp-primary) 0%, var(--lp-primary-dark) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    #chk24-wrapper .chk24-audience__card:hover {
        transform: translateY(-5px);
        border-color: var(--lp-primary);
        box-shadow: var(--lp-shadow-hover);
    }
    
    #chk24-wrapper .chk24-audience__card:hover::before {
        opacity: 0.05;
    }
    
    #chk24-wrapper .chk24-audience__icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, var(--lp-primary) 0%, var(--lp-primary-dark) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    #chk24-wrapper .chk24-audience__icon svg {
        width: 40px;
        height: 40px;
        fill: white;
    }
    
    #chk24-wrapper .chk24-audience__title {
        font-size: 1.3em;
        font-weight: 700;
        color: var(--lp-text-dark);
        margin-bottom: 10px;
    }
    
    /* תנאים וצ'קים */
    #chk24-wrapper .chk24-terms {
        padding: 60px 20px;
        background: var(--lp-gray-light);
    }
    
    #chk24-wrapper .chk24-check-examples {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 30px;
        margin: 40px 0;
    }
    
    #chk24-wrapper .chk24-check-example {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: var(--lp-shadow-soft);
        text-align: center;
    }
    
    #chk24-wrapper .chk24-check-example img {
        width: 100%;
        height: auto;
        border-radius: 10px;
        margin-bottom: 20px;
    }
    
    #chk24-wrapper .chk24-check-example__label {
        font-size: 1.2em;
        font-weight: 600;
    }
    
    #chk24-wrapper .chk24-check-example--valid {
        border: 2px solid var(--lp-success);
    }
    
    #chk24-wrapper .chk24-check-example--invalid {
        border: 2px solid var(--lp-secondary);
    }
    
    /* יתרונות וחסרונות */
    #chk24-wrapper .chk24-pros-cons {
        padding: 80px 20px;
        background: white;
    }
    
    #chk24-wrapper .chk24-pros-cons__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 40px;
        margin-top: 50px;
    }
    
    #chk24-wrapper .chk24-pros-cons__box {
        border-radius: 20px;
        padding: 40px;
        position: relative;
        overflow: hidden;
    }
    
    #chk24-wrapper .chk24-pros {
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
        border: 2px solid #4CAF50;
    }
    
    #chk24-wrapper .chk24-cons {
        background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
        border: 2px solid #f44336;
    }
    
    #chk24-wrapper .chk24-pros-cons__title {
        font-size: 1.8em;
        font-weight: 700;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    #chk24-wrapper .chk24-pros .chk24-pros-cons__title {
        color: #2e7d32;
    }
    
    #chk24-wrapper .chk24-cons .chk24-pros-cons__title {
        color: #c62828;
    }
    
    #chk24-wrapper .chk24-pros-cons__list {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    
    #chk24-wrapper .chk24-pros-cons__item {
        padding: 15px 40px 15px 0;
        position: relative;
        font-size: 1.1em;
        line-height: 1.6;
    }
    
    #chk24-wrapper .chk24-pros-cons__item::before {
        content: '';
        position: absolute;
        right: 0;
        top: 20px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    #chk24-wrapper .chk24-pros .chk24-pros-cons__item::before {
        content: '✓';
        background: #4CAF50;
        color: white;
    }
    
    #chk24-wrapper .chk24-cons .chk24-pros-cons__item::before {
        content: '✗';
        background: #f44336;
        color: white;
    }
    
    /* כפתור WhatsApp צף */
    #chk24-wrapper .chk24-whatsapp-section {
        margin: 80px 0;
        padding: 60px 20px;
        background: linear-gradient(135deg, var(--lp-success) 0%, #128C7E 100%);
        border-radius: 30px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    
    #chk24-wrapper .chk24-whatsapp-section::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: chk24-rotate 20s linear infinite;
    }
    
    @keyframes chk24-rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__content {
        position: relative;
        z-index: 2;
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__title {
        font-size: 2.5em;
        font-weight: 700;
        color: white;
        margin-bottom: 15px;
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__text {
        font-size: 1.3em;
        color: rgba(255,255,255,0.9);
        margin-bottom: 30px;
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__btn {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        background: white;
        color: var(--lp-success);
        padding: 18px 40px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.2em;
        transition: var(--lp-transition);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }
    
    #chk24-wrapper .chk24-whatsapp-cta__icon {
        width: 30px;
        height: 30px;
    }
    
    /* טבלת השוואת ריביות */
    #chk24-wrapper .chk24-comparison-table {
        width: 100%;
        border-collapse: collapse;
        margin: 40px 0;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: var(--lp-shadow-medium);
    }
    
    #chk24-wrapper .chk24-comparison-table th {
        background: linear-gradient(135deg, var(--lp-primary) 0%, var(--lp-primary-dark) 100%);
        color: white;
        padding: 20px;
        text-align: right;
        font-weight: 700;
        font-size: 1.2em;
    }
    
    #chk24-wrapper .chk24-comparison-table td {
        padding: 20px;
        border-bottom: 1px solid var(--lp-gray-medium);
        font-size: 1.1em;
    }
    
    #chk24-wrapper .chk24-comparison-table tr:last-child td {
        border-bottom: none;
    }
    
    #chk24-wrapper .chk24-comparison-table tr:hover td {
        background: var(--lp-gray-light);
    }
    
    /* מחשבון הלוואה */
    #chk24-wrapper .chk24-calculator {
        background: linear-gradient(135deg, var(--lp-gray-light) 0%, white 100%);
        border-radius: 20px;
        padding: 40px;
        margin: 40px 0;
        box-shadow: var(--lp-shadow-medium);
    }
    
    #chk24-wrapper .chk24-calculator__title {
        font-size: 2em;
        font-weight: 700;
        color: var(--lp-primary);
        margin-bottom: 30px;
        text-align: center;
    }
    
    /* אזורי שירות */
    #chk24-wrapper .chk24-service-areas {
        padding: 80px 20px;
        background: var(--lp-gray-light);
    }
    
    #chk24-wrapper .chk24-areas-table {
        width: 100%;
        border-collapse: collapse;
        margin: 40px 0;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: var(--lp-shadow-soft);
    }
    
    #chk24-wrapper .chk24-areas-table th {
        background: var(--lp-primary);
        color: white;
        padding: 15px;
        text-align: center;
        font-weight: 600;
    }
    
    #chk24-wrapper .chk24-areas-table td {
        padding: 15px;
        text-align: center;
        border-bottom: 1px solid var(--lp-gray-medium);
        border-left: 1px solid var(--lp-gray-medium);
    }
    
    #chk24-wrapper .chk24-areas-table td:last-child {
        border-left: none;
    }
    
    /* FAQ */
    #chk24-wrapper .chk24-faq {
        padding: 80px 20px;
        background: white;
    }
    
    #chk24-wrapper .chk24-faq__title {
        font-size: 2.5em;
        font-weight: 700;
        color: var(--lp-primary);
        text-align: center;
        margin-bottom: 50px;
    }
    
    /* CTA סופי */
    #chk24-wrapper .chk24-final-cta {
        padding: 80px 20px;
        background: linear-gradient(135deg, var(--lp-primary-dark) 0%, var(--lp-primary) 100%);
        text-align: center;
    }
    
    #chk24-wrapper .chk24-final-cta__title {
        font-size: 2.5em;
        font-weight: 700;
        color: white;
        margin-bottom: 20px;
    }
    
    #chk24-wrapper .chk24-final-cta__text {
        font-size: 1.3em;
        color: rgba(255,255,255,0.9);
        margin-bottom: 40px;
    }
    
    /* אנימציות כניסה */
    #chk24-wrapper .chk24-fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease-out;
    }
    
    #chk24-wrapper .chk24-fade-in.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* Mobile Responsive */
    @media (max-width: 768px) {
        #chk24-wrapper .chk24-hero__title {
            font-size: 2.5em;
        }
        
        #chk24-wrapper .chk24-hero__subtitle {
            font-size: 1.2em;
        }
        
        #chk24-wrapper .chk24-hero__features {
            flex-direction: column;
            gap: 20px;
        }
        
        #chk24-wrapper .chk24-section__title {
            font-size: 2em;
        }
        
        #chk24-wrapper .chk24-pros-cons__grid {
            grid-template-columns: 1fr;
        }
        
        #chk24-wrapper .chk24-whatsapp-cta__title {
            font-size: 2em;
        }
    }
    </style>
    <div id="chk24-wrapper" class="chk24-page edit-hoverable"><!-- Hero Section דינמי -->
    <div class="chk24-hero edit-hoverable">
    <div class="chk24-hero__particles edit-hoverable"></div>
    <div class="chk24-hero__content edit-hoverable">
    <h1 class="chk24-hero__title edit-hoverable">הלוואה בצ'קים - פתרון מימון מהיר</h1>
    <div class="chk24-hero__subtitle edit-hoverable">קבלו כסף מיידי עד הבית תוך שעות ספורות</div>
    <div class="chk24-hero-update-date edit-hoverable" style="color: rgba(255,255,255,0.9); font-weight: 600; margin-bottom: 10px;">
      <strong class="edit-hoverable">עודכן לאחרונה:</strong> [current_date format="F Y" hebrew="true"]
    </div>
    <p class="chk24-rate-info edit-hoverable" style="font-size: 0.95em; color: rgba(255,255,255,0.9); margin-bottom: 30px;">
      💡 הריביות בתוכן מעודכנות לפי ריבית פריים 5.5% (ריבית בנק ישראל 4%, נכון לינואר 2026)
    </p>
    <div class="chk24-hero__features edit-hoverable">
    <div class="chk24-hero__feature edit-hoverable">
    <div class="chk24-hero__icon edit-hoverable">✓</div>
    אישור מיידי</div>
    <div class="chk24-hero__feature edit-hoverable">
    <div class="chk24-hero__icon edit-hoverable">✓</div>
    ללא ערבים</div>
    <div class="chk24-hero__feature edit-hoverable">
    <div class="chk24-hero__icon edit-hoverable">✓</div>
    עד 24 תשלומים</div>
    </div>
    <div class="chk24-hero__cta edit-hoverable">
        <a class="chk24-btn chk24-btn--primary edit-hoverable" href="#chk24-form">קבלו הצעת מחיר עכשיו ←</a>
    </div>
    </div>
    </div>
    <!-- פסקת פתיחה + ווידג'ט -->
    <div class="chk24-section chk24-intro edit-hoverable">
        <div class="chk24-container edit-hoverable">
            <h2 class="chk24-section__title chk24-fade-in active edit-hoverable">הלוואות בצ'קים - הפתרון המושלם למימון מהיר גם למסורבים!</h2>
            
            <p class="chk24-lead chk24-fade-in active edit-hoverable">בעולם המימון המודרני, הלוואה בצ'קים הפכה לאפשרות פופולרית עבור אנשים המחפשים פתרונות מימון מהירים ונגישים. אצל כל אדם, בין אם שכיר ובין אם עצמאי, עשוי להתעורר צורך בהלוואה בנקודה כלשהי בחייו.</p>
        </div>
    </div>
    <!-- ווידג'ט לידים - ממורכז ללא הגבלת רוחב -->
    <div id="chk24-form" class="chk24-widget-container chk24-fade-in active edit-hoverable">
        [awg postid="32400"]
    </div>
    <!-- מהי הלוואה בצ'קים -->
    <div class="chk24-section chk24-what-is edit-hoverable">
    <div class="chk24-container edit-hoverable">
    <h2 class="chk24-section__title chk24-fade-in active edit-hoverable">מהי הלוואה בצ'קים?</h2>
    <p class="chk24-lead chk24-fade-in active edit-hoverable">הלוואה בפריסת צ'קים היא <a href="https://loan-israel.co.il/non-bank-loan/" class="edit-hoverable">הלוואה חוץ בנקאית לכל מטרה</a>. למעשה, זו הלוואה מהירה שאינה משפיעה על האובליגו בבנק. לרוב ניתן לגייס סכום כסף של עד כמה עשרות אלפי שקלים, ויש אפשרות לפרוס את התשלומים על פני תקופה של שנה עד שנתיים.</p>
    <p class="chk24-lead chk24-fade-in active edit-hoverable">בשיטה זו, הלווה מקבל את סכום ההלוואה במזומן או בהעברה בנקאית, ובתמורה מוסר למלווה מספר צ'קים שתאריכי הפירעון שלהם מפוזרים לאורך תקופת ההחזר המוסכמת. תהליך קבלת הלוואה כנגד צ'קים הוא לרוב פשוט ומהיר יותר מאשר הלוואות בנקאיות מסורתיות.</p>
    </div>
    </div>
