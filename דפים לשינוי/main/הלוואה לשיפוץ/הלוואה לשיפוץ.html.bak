    <div id="shiputz24-wrapper" class="shiputz24-page edit-hoverable">
        
        <!-- Hero Section with Calculator -->
        <div class="shiputz24-hero edit-hoverable">
            <div class="shiputz24-hero__animation edit-hoverable">
                <svg class="shiputz24-hero__house" viewBox="0 0 200 200" fill="none">
                    <rect x="50" y="100" width="100" height="80" fill="currentColor"></rect>
                    <polygon points="50,100 100,50 150,100" fill="currentColor"></polygon>
