}

/* Mobile Responsive */
@media (max-width: 768px) {
  .wpc-loans-n8y3-timeline-wrapper {
    padding: 30px 15px 30px 20px !important;
  }

  .wpc-loans-n8y3-timeline-line {
    right: 38px !important;
  }

  .wpc-loans-n8y3-timeline-item {
    padding-right: 80px !important;
  }

  .wpc-loans-n8y3-timeline-circle {
    width: 50px !important;
    height: 50px !important;
    font-size: 1.2em !important;
    right: 15px !important;
  }
}

@media (max-width: 480px) {
  .wpc-loans-n8y3-stats-section {
    padding: 40px 15px !important;
  }

  .wpc-loans-n8y3-stats-container {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 15px !important;
  }

  .wpc-loans-n8y3-stats-number {
    font-size: 1.8em !important;
  }

  .wpc-loans-n8y3-stats-label {
    font-size: 1em !important;
  }

  .wpc-loans-n8y3-cta-btn {
    width: 100% !important;
    box-sizing: border-box !important;
    font-size: 1.1em !important;
  }

  .wpc-loans-n8y3-faq-question {
    padding: 15px 20px !important;
  }

  .wpc-loans-n8y3-faq-question-text {
    font-size: 1em !important;
  }

  .wpc-loans-n8y3-faq-answer p {
    padding: 15px 20px !important;
    font-size: 0.95em !important;
  }
