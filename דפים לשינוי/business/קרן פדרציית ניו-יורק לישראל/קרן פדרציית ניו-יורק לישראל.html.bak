</style>

<!-- FAQ JavaScript -->
<script>
(function() {
  'use strict';

  const ns = 'WPC_Loans_N8Y3_FAQ';
  if (window[ns]) return;
  window[ns] = true;

  const container = document.querySelector('.wpc-loans-n8y3-faq-container');
  if (!container) return;

  container.addEventListener('click', function(e) {
    const button = e.target.closest('[data-action="toggle-faq"]');
    if (!button) return;

    e.preventDefault();
    const item = button.closest('.wpc-loans-n8y3-faq-item');
    if (!item) return;

    const wasActive = item.classList.contains('active');

    document.querySelectorAll('.wpc-loans-n8y3-faq-item').forEach(function(faqItem) {
      faqItem.classList.remove('active');
    });

    if (!wasActive) {
      item.classList.add('active');
    }
  });
})();
</script>

</div>