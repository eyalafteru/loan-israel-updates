<!-- ================================================ -->
<!-- JavaScript for FAQ Accordion -->
<!-- ================================================ -->
<script>
(function() {
  'use strict';

  const ns = 'WPC_Loans_FAQ_F3K8';
  if (window[ns]) return;
  window[ns] = true;

  const faqContainer = document.querySelector('.wpc-loans-f3k8-faq-container');
  if (!faqContainer) return;

  faqContainer.addEventListener('click', function(e) {
    const button = e.target.closest('[data-action="wpc-faq-f3k8-toggle"]');
    if (!button) return;

    e.preventDefault();

    const item = button.closest('.wpc-loans-f3k8-faq-item');
    const answer = item.querySelector('.wpc-loans-f3k8-faq-answer');
    const isActive = button.classList.contains('active');

    // Close all other items
    faqContainer.querySelectorAll('.wpc-loans-f3k8-faq-question.active').forEach(function(activeBtn) {
      if (activeBtn !== button) {
        activeBtn.classList.remove('active');
        const activeAnswer = activeBtn.closest('.wpc-loans-f3k8-faq-item').querySelector('.wpc-loans-f3k8-faq-answer');
        activeAnswer.classList.remove('show');
      }
    });

    // Toggle current item
    if (isActive) {
      button.classList.remove('active');
      answer.classList.remove('show');
    } else {
      button.classList.add('active');
      answer.classList.add('show');
    }
  });
})();
</script>

