<!-- JavaScript for FAQ Accordion -->
<script>
(function() {
  'use strict';

  var ns = 'WPC_Loans_K8W4';
  if (window[ns]) return;
  window[ns] = true;

  var faqContainer = document.querySelector('.wpc-loans-k8w4-faq-container');
  if (!faqContainer) return;

  faqContainer.addEventListener('click', function(e) {
    var button = e.target.closest('[data-action="wpc-k8w4-toggle-faq"]');
    if (!button) return;

    var faqItem = button.closest('.wpc-loans-k8w4-faq-item');
    if (!faqItem) return;

    var isActive = faqItem.classList.contains('active');

    // Close all other FAQs
    var allFaqs = faqContainer.querySelectorAll('.wpc-loans-k8w4-faq-item');
    allFaqs.forEach(function(item) {
      item.classList.remove('active');
    });

    // Toggle current FAQ
    if (!isActive) {
      faqItem.classList.add('active');
    }
  });
})();
</script>

