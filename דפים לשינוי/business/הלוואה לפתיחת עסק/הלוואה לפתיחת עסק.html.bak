    right: 15px !important;
  }
}

@media (max-width: 480px) {
  .wpc-loans-w5n7-stats-section {
    padding: 40px 15px !important;
  }

  .wpc-loans-w5n7-stats-container {
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 15px !important;
