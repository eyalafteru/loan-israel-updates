  border-radius: 50px !important;
  transition: transform 0.2s, box-shadow 0.2s !important;
  box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
  color: white !important;
}

.wpc-loans-w5n7-cta-btn:hover {
  transform: translateY(-3px) !important;
  box-shadow: 0 6px 20px rgba(0,0,0,0.25) !important;
}

.wpc-loans-w5n7-cta-btn-red {
  background: #ff3b3b !important;
  border: 2px solid #ff3b3b !important;
}

.wpc-loans-w5n7-cta-btn-blue {
  background: #1e5490 !important;
  border: 2px solid #1e5490 !important;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .wpc-loans-w5n7-timeline-wrapper {
    padding: 30px 15px 30px 20px !important;
  }

  .wpc-loans-w5n7-timeline-line {
