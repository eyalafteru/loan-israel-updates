<!-- ================================================================ -->
<!-- JavaScript -->
<!-- ================================================================ -->
<script>
(function() {
  'use strict';
  var ns = 'WPC_Loans_W5N7';
  if (window[ns]) return;
  window[ns] = true;

  // FAQ Accordion
  var faqContainer = document.querySelector('.wpc-loans-w5n7-faq-container');
  if (!faqContainer) return;

  faqContainer.addEventListener('click', function(e) {
    var button = e.target.closest('[data-action="toggle-faq"]');
    if (!button) return;

    var item = button.closest('.wpc-loans-w5n7-faq-item');
    if (!item) return;

    var isActive = item.classList.contains('active');

    // Close all items
    var allItems = faqContainer.querySelectorAll('.wpc-loans-w5n7-faq-item');
    allItems.forEach(function(i) {
      i.classList.remove('active');
    });

    // Open clicked item if it wasn't active
    if (!isActive) {
      item.classList.add('active');
    }
  });

  // Smooth scroll for CTA buttons
  var ctaButtons = document.querySelectorAll('.wpc-loans-w5n7-cta-btn[href^="#"]');
  ctaButtons.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var targetId = this.getAttribute('href').substring(1);
      var targetElement = document.getElementById(targetId);
      if (targetElement) {
        targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
})();
</script>

